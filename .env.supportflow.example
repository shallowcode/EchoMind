# Use SF_* values with api.main:app. No provider is selected or charged implicitly.
SF_MODEL_BACKEND=compatible
SF_MODEL_URL=http://127.0.0.1:8081/v1
SF_MODEL_NAME=Qwen3-1.7B-Q8_0
SF_MODEL_KEY=
SF_LOCAL_CHAT_TEMPLATE=true
# GLM-4.5-Air profile: save private values to .runtime/glm.env and set SF_ENV_FILE.
# SF_MODEL_URL=https://open.bigmodel.cn/api/paas/v4
# SF_MODEL_NAME=glm-4.5-air
# SF_LOCAL_CHAT_TEMPLATE=false
# SF_SUPPORTS_JSON_SCHEMA=false
# SF_MODEL_THINKING=disabled
# SF_PRICING_PROFILE=glm-air-20260908
SF_PUBLIC_URL=http://localhost:8000
SF_DB_PATH=data/supportflow.sqlite3
SF_STORAGE=chroma
SF_CHROMA_PATH=data/supportflow-chroma
SF_REDIS_URL=
SF_BUSINESS_MODE=sandbox
SF_MODEL_TIMEOUT=90
SF_REQUEST_TIMEOUT=180
SF_MAX_INFLIGHT=4
# Leave prices UNSET until confirmed; blank numeric environment values are invalid.
# SF_MODEL_INPUT_PRICE=price per million input tokens
# SF_MODEL_OUTPUT_PRICE=price per million output tokens
# SF_MACHINE_HOURLY_COST=measured hourly infrastructure allocation
# External payment adapter configuration requires a provider contract review:
# SF_PAYMENT_URL=https://provider.example
# SF_PAYMENT_KEY=...
# SF_PAYMENT_WEBHOOK_SECRET=...
