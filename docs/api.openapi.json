  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Approval"
      },
      "ChatInput": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Message"
          },
          "conv_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,80}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conv Id"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "request_id"
        ],
        "title": "ChatInput"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "content"
        ],
        "title": "Document"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RefundInput": {
        "properties": {
          "order_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Order Id"
          },
          "amount_cents": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Cents"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_id",
          "amount_cents",
          "reason",
          "idempotency_key"
        ],
        "title": "RefundInput"
      },
      "Revoke": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Revoke"
      },
      "TicketInput": {
        "properties": {
          "conv_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Conv Id"
          },
          "summary": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Summary"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conv_id",
          "summary",
          "idempotency_key"
        ],
        "title": "TicketInput"
      },
      "TicketUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "assignee": {
            "type": "string",
            "title": "Assignee",
            "default": ""
          },
          "resolution": {
            "type": "string",
            "maxLength": 4000,
            "title": "Resolution",
            "default": ""
          },
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "TicketUpdate"
      },
      "TokenInput": {
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "User"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Roles"
          },
          "ttl": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 60.0,
            "title": "Ttl",
            "default": 3600
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user",
          "roles"
        ],
        "title": "TokenInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
