# Resume-aligned FastAPI + ChromaDB + Redis sandbox. Copy to .env.resume.
SF_MODEL_BACKEND=compatible
SF_MODEL_URL=https://open.bigmodel.cn/api/paas/v4
SF_MODEL_NAME=glm-4.5-air
SF_MODEL_KEY=
SF_LOCAL_CHAT_TEMPLATE=false
SF_SUPPORTS_JSON_SCHEMA=false
SF_MODEL_THINKING=disabled
SF_DB_PATH=data/supportflow-resume.sqlite3
SF_BUSINESS_URL=
SF_BUSINESS_MODE=sandbox
SF_STORAGE=chroma
SF_CHROMA_MODE=http
SF_CHROMA_HOST=localhost
SF_CHROMA_PORT=8001
SF_CHROMA_SSL=false
SF_REDIS_PASSWORD=
# Password in URL must be percent encoded if it contains reserved characters.
SF_REDIS_URL=redis://:replace-with-your-password@localhost:6379/0
SF_REQUIRE_MEMORY_SERVICES=true
SF_PUBLIC_URL=http://localhost:8000
SF_MAX_INFLIGHT=2
SF_LOCAL_DEMO_ACCESS=true
